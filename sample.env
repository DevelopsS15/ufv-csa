NODE_ENV="production"

# Base domain (e.g. csa.ufv.ca)
SITE_DOMAIN="csa.ufv.ca"

# Umami Analytics https://umami.is/. Leave commented out to disable
# NEXT_PUBLIC_UMAMI_ANALYTICS_SITE_ID=""

# Sanity CMS https://www.sanity.io/
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_PROJECT_ID="<REPLACE ME>"
SANITY_WEBHOOK_MESSAGE_SECRET="<REPLACE ME>"
SANITY_API_WRITE_TOKEN="<REPLACE ME>"

# Used for basic authentication of cron jobs which ping /api/events/reminders and /api/announcements/ufv-news
AUTH_TOKEN_EVENT_REMINDERS="<REPLACE ME>"
AUTH_TOKEN_UFV_NEWS="<REPLACE ME>"

# Discord bot credentials
DISCORD_BOT_TOKEN="<REPLACE ME>"
DISCORD_BOT_ID="<REPLACE ME>"
DISCORD_PUBLIC_KEY="<REPLACE ME>"

# Discord server which owns the channels listed below
DISCORD_SERVER_ID="<REPLACE ME>"
# Discord server invite for event messages
DISCORD_SERVER_INVITE_LINK="https://discord.gg/<REPLACE ME>"

# Discord channels for event-related messages
DISCORD_EVENT_CHANNEL_ID="<REPLACE ME>"
DISCORD_EVENT_REMINDER_CHANNEL_ID="<REPLACE ME>"
# Discord Ids used for Student Computing Centre room status
DISCORD_SCC_ROOM_CHANNEL_ID="<REPLACE ME>"
DISCORD_SCC_ROOM_ROLE_ID="<REPLACE ME>"
# Discord Ids used for posting announcement messages
DISCORD_ANNOUNCEMENT_CHANNEL_ID_CSA="<REPLACE ME>"
DISCORD_ANNOUNCEMENT_CHANNEL_ID_IEEE="<REPLACE ME>"
# Discord Id used for UFV urgent and IT Service blog/news
DISCORD_UFV_NEWS_CHANNEL_ID="<REPLACE ME>"
